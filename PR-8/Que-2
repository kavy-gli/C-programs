#include <stdio.h>

int main()
{
    int a[100], i, n;
    int *ptr;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    ptr = a;

    for(i = 0; i < n; i++)
    {
        printf("Enter element: ");
        scanf("%d", &ptr[i]);
    }

    for(i = 0; i < n; i++)
    {
        printf("Cube of %d is %d\n", ptr[i], ptr[i] * ptr[i] * ptr[i]);
    }

    return 0;
}
